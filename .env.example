# Скопируйте в .env. Пусто/не задано — в dev используется localhost:8080,
# в проде фронтенд и бэкенд считаются одним origin (относительные /api-запросы).
VITE_API_URL=http://localhost:8080

# Временные контактные данные оператора для страниц с юридической информацией.
# Не содержат юридического адреса — он ещё не определён.
VITE_OPERATOR_EMAIL=support@hayhome.am
VITE_OPERATOR_CITY=Yerevan

# API-ключ Yandex Maps JS API 3.0 (console.yandex.ru). Пусто — карта показывает
# честное состояние недоступности со ссылкой на точку и кнопкой "Повторить",
# без имитации карты. Ключ и allowlist доменов настраиваются только в консоли.
VITE_YANDEX_MAPS_API_KEY=
